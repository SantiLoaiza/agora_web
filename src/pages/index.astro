---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Fleet from '../components/Fleet.astro';
import Coverage from '../components/Coverage.astro';
import Process from '../components/Process.astro';
import Technology from '../components/Technology.astro';
import Industries from '../components/Industries.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import { homeFaqs } from '../data/faqs';
import { faqSchema } from '../data/schema';
---

<Layout
  title="Transporte de carga en Colombia | AGORA STRATEGY"
  description="Transporte de carga masiva, semimasiva y distribución desde Bogotá a los 32 departamentos. Flota de Carry a tractomula y monitoreo 24/7."
  schema={[faqSchema(homeFaqs)]}
>
  <Header />
  <main>
    <Hero />
    <Services />
    <Fleet />
    <Coverage />
    <Process />
    <Technology />
    <Industries />
    <About />
    <Faq items={homeFaqs} />
  </main>
  <ContactSection />
  <Footer />
</Layout>
