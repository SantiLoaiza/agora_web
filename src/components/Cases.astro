---
const cases = [
  {
    dark: false,
    tag: 'Transporte · Farmacéutico',
    tagColor: '#8A7238',
    metric: '99,4%',
    metricLabel: 'de entregas en ventana pactada',
    text: 'Cadena de frío entre Bogotá, Medellín y el Eje Cafetero, con registro de temperatura por tramo.',
    footer: '14 meses · Ruta nacional',
  },
  {
    dark: true,
    tag: 'Transporte + Consultoría · Retail',
    tagColor: '#BD9750',
    metric: '7 → 3',
    metricLabel: 'días de inventario en tránsito',
    text: 'Rediseñamos el abastecimiento de una cadena de 22 tiendas y luego asumimos su transporte primario.',
    footer: 'Diagnóstico y operación · 22 tiendas',
  },
  {
    dark: false,
    tag: 'Consultoría · Alimentos',
    tagColor: '#8A7238',
    metric: '-18%',
    metricLabel: 'en costo por unidad producida',
    text: 'Rediseño de procesos y estructura de costos en una procesadora bogotana de 140 empleados.',
    footer: 'Seis meses · Bogotá',
  },
];
---

<section id="casos" data-screen-label="Casos" style="background:#EFEBE0;border-top:1px solid rgba(12,32,62,0.08);border-bottom:1px solid rgba(12,32,62,0.08);scroll-margin-top:88px">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,10vw,120px) 24px">
    <div class="reveal" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:clamp(40px,6vw,64px)">
      <h2 style="margin:0;font-family:Montserrat,sans-serif;font-weight:300;font-size:clamp(28px,3.3vw,45px);line-height:1.16;letter-spacing:-1px;color:#0C203E;max-width:16ch">Resultados que se pueden auditar</h2>
      <a href="#contacto" class="link-slide link-navy" style="font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:#8A7238;padding-bottom:6px">Ver todos los casos</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(20px,2.5vw,28px)">
      {cases.map((c) => (
        <article
          class="reveal lift"
          style={`background:${c.dark ? '#0C203E' : '#F7F5EF'};border:1px solid ${c.dark ? '#0C203E' : 'rgba(12,32,62,0.10)'};display:flex;flex-direction:column`}
        >
          <div style="padding:34px 28px 36px;display:flex;flex-direction:column;flex:1;border-top:3px solid #BD9750">
            <p style={`margin:0 0 20px;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:${c.tagColor}`}>{c.tag}</p>
            <p class="metric" style={`margin:0;font-family:'Cormorant Garamond',serif;font-size:56px;line-height:1;color:${c.dark ? '#F7F5EF' : '#0C203E'}`}>{c.metric}</p>
            <p style={`margin:12px 0 0;font-size:13px;font-weight:500;letter-spacing:0.3px;color:${c.dark ? '#F7F5EF' : '#0C203E'}`}>{c.metricLabel}</p>
            <p style={`margin:16px 0 26px;font-size:14px;font-weight:300;line-height:1.7;color:${c.dark ? '#B7BDC8' : '#4A5262'}`}>{c.text}</p>
            <p style={`margin:auto 0 0;padding-top:18px;border-top:1px solid ${c.dark ? 'rgba(247,245,239,0.18)' : 'rgba(12,32,62,0.12)'};font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:${c.dark ? '#9AA2B0' : '#6E7686'}`}>{c.footer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
