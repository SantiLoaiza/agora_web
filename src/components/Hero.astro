---
const stats = [
  { value: '32', label: 'Departamentos cubiertos', countTo: '32' },
  { value: '+1.100', label: 'Municipios atendidos', countTo: null },
  { value: '+150', label: 'Vehículos en operación', countTo: '150', prefix: '+' },
  { value: '+300', label: 'Colaboradores capacitados', countTo: '300', prefix: '+' },
];
---

<section id="inicio" data-screen-label="Hero" style="position:relative;background:#0C203E;padding:clamp(72px,10vw,132px) 24px clamp(64px,9vw,108px)">
  <div style="position:absolute;inset:0;background:radial-gradient(110% 85% at 84% 6%, rgba(189,151,80,0.11) 0%, rgba(12,32,62,0) 60%);pointer-events:none"></div>
  <div style="position:relative;max-width:1200px;margin:0 auto">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:clamp(40px,5vw,72px);align-items:center">
      <div>
        <p class="hero-in" style="animation-delay:.05s;margin:0 0 28px;font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:#BD9750">Transporte y logística · Bogotá, Colombia</p>
        <h1 class="hero-in" style="animation-delay:.18s;margin:0;font-family:Montserrat,sans-serif;font-weight:300;font-size:clamp(34px,5vw,68px);line-height:1.1;letter-spacing:-1.4px;color:#F7F5EF;max-width:15ch">Moviendo al mundo<br /><span style="color:#BD9750">con inteligencia.</span></h1>
        <p class="hero-in" style="animation-delay:.3s;margin:30px 0 0;max-width:52ch;font-size:clamp(15px,1.3vw,17.5px);font-weight:300;line-height:1.75;color:#C4C9D2">Carga masiva, semimasiva y distribución en los 32 departamentos del país. Flota propia, trazabilidad 24/7 y entregas en los tiempos que pactamos.</p>
        <div class="hero-in" style="animation-delay:.42s;display:flex;flex-wrap:wrap;gap:14px;margin-top:40px">
          <a href="#contacto" data-pick-intent="logistica" class="btn-fill-gold" style="background:#F7F5EF;color:#0C203E;font-size:11.5px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;padding:19px 34px;min-height:44px;display:inline-flex;align-items:center">Cotizar un despacho</a>
          <a href="#servicios" class="btn-sweep" style="border:1px solid rgba(247,245,239,0.38);color:#F7F5EF;font-size:11.5px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;padding:19px 34px;min-height:44px;display:inline-flex;align-items:center;transition:border-color .25s ease,color .25s ease">Ver servicios</a>
        </div>
      </div>

      <aside class="hero-in" aria-label="Seguimiento de despacho en vivo" style="animation-delay:.52s;background:rgba(247,245,239,0.04);border:1px solid rgba(189,151,80,0.32);padding:clamp(22px,2.4vw,30px)">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:18px;border-bottom:1px solid rgba(247,245,239,0.12)">
          <div style="display:flex;align-items:center;gap:10px">
            <span class="live-dot" style="width:8px;height:8px;background:#BD9750;border-radius:50%;display:block;flex:none"></span>
            <p style="margin:0;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#BD9750">Despacho en ruta</p>
          </div>
          <p style="margin:0;font-size:11px;font-weight:500;letter-spacing:1.8px;color:#98A0AF">WGX 482 · Sencillo 7 TON</p>
        </div>

        <div style="display:grid;grid-template-columns:auto 1fr;gap:0 20px;padding:26px 0 6px">
          <div style="position:relative;width:14px;display:flex;flex-direction:column;align-items:center">
            <span style="position:absolute;top:6px;bottom:6px;left:50%;width:1px;background:rgba(247,245,239,0.16);transform:translateX(-50%)"></span>
            <span id="hp-fill" style="position:absolute;top:6px;left:50%;width:1px;height:46%;background:#BD9750;transform:translateX(-50%);transition:height .5s linear"></span>
            <span id="hp-marker" style="position:absolute;top:46%;left:50%;transform:translate(-50%,-50%);transition:top .5s linear;color:#BD9750;font-size:11px;line-height:1">▲</span>
            <span style="width:9px;height:9px;border:1px solid #BD9750;background:#BD9750;border-radius:50%;margin-top:3px"></span>
            <span style="flex:1"></span>
            <span style="width:9px;height:9px;border:1px solid rgba(247,245,239,0.4);border-radius:50%;margin-bottom:3px"></span>
          </div>
          <div style="display:flex;flex-direction:column;gap:clamp(26px,3vw,40px)">
            <div>
              <p style="margin:0;font-size:9.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#8A94A6">Origen · 06:20</p>
              <p style="margin:5px 0 0;font-size:16px;font-weight:400;color:#F7F5EF">Bogotá · Sede principal</p>
            </div>
            <div>
              <p style="margin:0;font-size:9.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#8A94A6">Último reporte GPS</p>
              <p id="hp-place" style="margin:5px 0 0;font-size:16px;font-weight:400;color:#F7F5EF">Puerto Triunfo, Antioquia</p>
            </div>
            <div>
              <p style="margin:0;font-size:9.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#8A94A6">Destino · ETA <span id="hp-eta">15:40</span></p>
              <p style="margin:5px 0 0;font-size:16px;font-weight:400;color:#F7F5EF">Medellín · Sede regional</p>
            </div>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:26px;padding-top:22px;border-top:1px solid rgba(247,245,239,0.12)">
          <div>
            <p id="hp-pct" style="margin:0;font-family:'Cormorant Garamond',serif;font-size:30px;line-height:1;color:#F7F5EF">46%</p>
            <p style="margin:8px 0 0;font-size:9.5px;font-weight:500;letter-spacing:1.8px;text-transform:uppercase;color:#8A94A6">Avance</p>
          </div>
          <div>
            <p id="hp-km" style="margin:0;font-family:'Cormorant Garamond',serif;font-size:30px;line-height:1;color:#F7F5EF">232 km</p>
            <p style="margin:8px 0 0;font-size:9.5px;font-weight:500;letter-spacing:1.8px;text-transform:uppercase;color:#8A94A6">Restantes</p>
          </div>
          <div>
            <p style="margin:0;font-family:'Cormorant Garamond',serif;font-size:30px;line-height:1;color:#F7F5EF">24/7</p>
            <p style="margin:8px 0 0;font-size:9.5px;font-weight:500;letter-spacing:1.8px;text-transform:uppercase;color:#8A94A6">Monitoreo</p>
          </div>
        </div>

        <form id="ag-track-form" style="margin-top:26px;padding-top:22px;border-top:1px solid rgba(247,245,239,0.12);display:flex;flex-direction:column;gap:10px">
          <label for="ag-guia" style="font-size:9.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#BD9750">Consultar su guía</label>
          <div style="display:flex;flex-wrap:wrap;gap:10px">
            <input id="ag-guia" name="guia" type="text" autocomplete="off" placeholder="Número de guía" style="flex:1 1 160px;min-width:0;padding:12px 14px;min-height:46px;background:rgba(247,245,239,0.06);border:1px solid rgba(247,245,239,0.32);border-radius:0;font-size:14.5px;font-weight:400;color:#F7F5EF;outline:none;transition:border-color .2s ease;" />
            <a id="ag-guia-link" class="btn-track" href="https://agora.cloudrapp.site/assets/trace.html?nombre=ENC010&amp;P_PEDIDO=" target="_blank" rel="noopener noreferrer" style="flex:none;background:#BD9750;color:#0C203E;border:1px solid #BD9750;font-size:11px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;padding:0 26px;min-height:46px;display:inline-flex;align-items:center;cursor:pointer">Rastrear</a>
          </div>
          <p id="ag-guia-error" aria-live="polite" style="margin:0;font-size:12px;font-weight:400;line-height:1.5;color:#E08A8A;display:none">Ingrese el número de guía que aparece en su remesa.</p>
        </form>
      </aside>
    </div>

    <div class="hero-in" style="animation-delay:.62s;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:clamp(24px,4vw,48px);margin-top:clamp(48px,7vw,80px);padding-top:32px;border-top:1px solid rgba(189,151,80,0.28)">
      {stats.map((stat) => (
        <div>
          {stat.countTo ? (
            <p class="count" data-to={stat.countTo} data-prefix={stat.prefix} style="margin:0;font-family:'Cormorant Garamond',serif;font-size:44px;line-height:1;color:#F7F5EF">{stat.value}</p>
          ) : (
            <p style="margin:0;font-family:'Cormorant Garamond',serif;font-size:44px;line-height:1;color:#F7F5EF">{stat.value}</p>
          )}
          <p style="margin:12px 0 0;font-size:10.5px;font-weight:500;letter-spacing:2.2px;text-transform:uppercase;color:#98A0AF">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
