---
const items = [
  {
    title: 'Habilitación vigente',
    text: 'Empresa de transporte de carga habilitada ante el Ministerio de Transporte.',
  },
  {
    title: 'Pólizas de carga',
    text: 'Cobertura de mercancía y responsabilidad civil extracontractual en cada despacho.',
  },
  {
    title: 'GPS y trazabilidad 24/7',
    text: 'Monitoreo satelital permanente y reporte de novedades en tiempo real al cliente.',
  },
  {
    title: 'Conductores verificados',
    text: 'Estudio de seguridad, capacitación en manejo defensivo y control de horas de conducción.',
  },
];
---

<section data-screen-label="Respaldo" style="background:#0C203E">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(64px,8vw,100px) 24px">
    <div class="reveal" style="display:flex;align-items:baseline;gap:16px;margin-bottom:40px">
      <span class="rule-grow" style="width:34px;height:1px;background:#BD9750;display:block"></span>
      <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:#BD9750">Respaldo de la operación de transporte</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:clamp(24px,3vw,44px)">
      {items.map((item) => (
        <div class="reveal cred" style="border-top:1px solid rgba(189,151,80,0.35);padding-top:22px">
          <h3 style="margin:0;font-family:Montserrat,sans-serif;font-weight:500;font-size:19px;letter-spacing:-0.2px;color:#F7F5EF">{item.title}</h3>
          <p style="margin:10px 0 0;font-size:14px;font-weight:300;line-height:1.7;color:#B7BDC8">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
