---
const capabilities = [
  {
    label: 'Estrategia y crecimiento',
    svg: '<path d="M3 20h18M6 20V9m5 11V4m5 16v-7" stroke="#BD9750" stroke-width="1.5" />',
  },
  {
    label: 'Finanzas y métodos contables',
    svg: '<circle cx="12" cy="12" r="9" stroke="#BD9750" stroke-width="1.5" /><path d="M12 7v10M9.5 9.5h5M9.5 14.5h5" stroke="#BD9750" stroke-width="1.4" />',
  },
  {
    label: 'Mercadeo y relaciones públicas',
    svg: '<path d="M4 9v6h4l6 4V5L8 9H4z" stroke="#BD9750" stroke-width="1.5" /><path d="M18 9.5c1 1.6 1 3.4 0 5" stroke="#BD9750" stroke-width="1.4" />',
  },
  {
    label: 'Procesos y productividad',
    svg: '<path d="M4 5h7v6H4zM13 13h7v6h-7z" stroke="#BD9750" stroke-width="1.5" /><path d="M7.5 11v5h5.5" stroke="#BD9750" stroke-width="1.4" />',
  },
  {
    label: 'Talento humano y cultura',
    svg: '<circle cx="9" cy="8" r="3.2" stroke="#BD9750" stroke-width="1.5" /><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" stroke="#BD9750" stroke-width="1.5" /><path d="M16 6.5a3 3 0 010 6M17.5 19c0-2.2-.8-4-2.2-5" stroke="#BD9750" stroke-width="1.4" />',
  },
];
---

<section id="consultoria" data-screen-label="Consultoría" style="max-width:1200px;margin:0 auto;padding:clamp(64px,9vw,104px) 24px;scroll-margin-top:96px">
  <div class="reveal" style="background:#EFEBE0;border:1px solid rgba(12,32,62,0.10);padding:clamp(30px,4.2vw,60px);display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:clamp(30px,4vw,64px);align-items:start">
    <div>
      <p style="margin:0 0 20px;font-size:10.5px;font-weight:600;letter-spacing:2.6px;text-transform:uppercase;color:#8A7238">Segunda línea · Ágora Consultoría</p>
      <h2 style="margin:0;font-family:Montserrat,sans-serif;font-weight:300;font-size:clamp(26px,2.9vw,38px);line-height:1.2;letter-spacing:-0.8px;color:#0C203E">Asesoría empresarial para las decisiones que sostienen la operación</h2>
      <p style="margin:20px 0 30px;font-size:15.5px;font-weight:300;line-height:1.75;color:#4A5262;max-width:44ch">Acompañamos a la gerencia en estructura, plata, mercado, procesos y gente. Es la misma disciplina con la que planeamos cada despacho.</p>
      <a href="#contacto" data-pick-intent="consultoria" class="btn-fill-navy" style="border:1px solid #0C203E;color:#0C203E;font-size:11px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;padding:17px 30px;min-height:44px;display:inline-flex;align-items:center">Solicitar asesoría</a>
    </div>
    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;border-top:1px solid rgba(12,32,62,0.12)">
      {capabilities.map((cap) => (
        <li class="cap" style="display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid rgba(12,32,62,0.12);font-size:14.5px;color:#0C203E">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none" set:html={cap.svg} />{cap.label}
        </li>
      ))}
    </ul>
  </div>
</section>
