---
// Grid of internal-link cards (related services, vehicles, cities).
interface Props {
  items: { href: string; title: string; text: string; meta?: string }[];
  minWidth?: number;
}

const { items, minWidth = 240 } = Astro.props;
---

<div style={`display:grid;grid-template-columns:repeat(auto-fit,minmax(min(${minWidth}px,100%),1fr));gap:clamp(14px,1.8vw,18px)`}>
  {items.map((item) => (
    <a href={item.href} class="reveal lift" style="display:flex;flex-direction:column;gap:10px;background:#FFFDF8;border:1px solid rgba(12,32,62,0.10);border-top:3px solid #BD9750;padding:clamp(22px,2.6vw,30px);color:#0C203E">
      {item.meta && <span style="font-size:11px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;color:#8A7238">{item.meta}</span>}
      <span style="font-size:17px;font-weight:500;line-height:1.3;color:#0C203E">{item.title}</span>
      <span style="font-size:14px;font-weight:300;line-height:1.7;color:#4A5262">{item.text}</span>
      <span aria-hidden="true" style="margin-top:auto;padding-top:6px;font-size:11px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;color:#8A7238">Ver más →</span>
    </a>
  ))}
</div>
