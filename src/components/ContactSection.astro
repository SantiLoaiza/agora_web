---
const whatsappNumber = '573163174316';
const whatsappDisplay = '+57 316 317 4316';
const whatsappMessage = encodeURIComponent('Hola, quiero cotizar un transporte de carga o una asesoría empresarial.');
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section id="contacto" data-screen-label="Contacto" style="background:#EFEBE0;border-top:1px solid rgba(12,32,62,0.08);scroll-margin-top:88px">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,10vw,120px) 24px">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(36px,5vw,72px);align-items:start">
      <div class="reveal">
        <p style="margin:0 0 22px;font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:#8A7238">Contáctenos</p>
        <h2 style="margin:0;font-family:Montserrat,sans-serif;font-weight:300;font-size:clamp(28px,3.3vw,45px);line-height:1.16;letter-spacing:-1px;color:#0C203E;max-width:14ch">Cuéntenos qué necesita mover</h2>
        <p style="margin:24px 0 0;font-size:16px;font-weight:300;line-height:1.8;color:#4A5262;max-width:40ch">Escríbanos por WhatsApp y hablamos con un coordinador de inmediato: sin formularios ni esperas. Atención de lunes a sábado.</p>
        <div style="margin-top:44px;display:flex;flex-direction:column;gap:20px;border-top:1px solid rgba(12,32,62,0.14);padding-top:28px">
          <div>
            <p style="margin:0;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#6E7686">Teléfono</p>
            <p style="margin:6px 0 0;font-size:16px;font-weight:400;color:#0C203E">{whatsappDisplay}</p>
          </div>
          <div>
            <p style="margin:0;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#6E7686">Sede principal</p>
            <p style="margin:6px 0 0;font-size:16px;font-weight:400;color:#0C203E">Bogotá · Colombia</p>
          </div>
          <div>
            <p style="margin:0;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#6E7686">Sedes regionales</p>
            <p style="margin:6px 0 0;font-size:16px;font-weight:400;color:#0C203E">Cali · Medellín</p>
          </div>
        </div>
      </div>

      <div class="reveal" style="display:flex;flex-direction:column;gap:16px">
        <div style="background:#0C203E;border-top:3px solid #BD9750;padding:clamp(28px,3.6vw,44px)">
          <div style="display:flex;align-items:center;gap:14px;margin-bottom:28px">
            <span style="width:40px;height:40px;border:1px solid #BD9750;border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2.5a9.5 9.5 0 00-8.1 14.4L2.5 21.5l4.8-1.4A9.5 9.5 0 1012 2.5z" stroke="#BD9750" stroke-width="1.4" />
                <path d="M8.3 8.6c-.3.8 0 1.9.9 3.2 1 1.5 2.2 2.5 3.6 3.1.9.4 1.6.3 2.1-.2l.5-.5-1.6-1.4-.5.4c-.2.2-.4.2-.7 0-.5-.3-1.1-.7-1.5-1.3-.5-.6-.8-1.1-1-1.6-.1-.3 0-.5.2-.7l.4-.4-1.2-1.8-1.2.2z" fill="#BD9750" />
              </svg>
            </span>
            <p style="margin:0;font-size:11px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:#BD9750">WhatsApp · {whatsappDisplay}</p>
          </div>
          <h3 style="margin:0;font-family:Montserrat,sans-serif;font-weight:400;font-size:clamp(24px,2.6vw,32px);line-height:1.25;letter-spacing:-0.4px;color:#F7F5EF">Escríbanos y hablamos<br />hoy mismo</h3>
          <p style="margin:20px 0 30px;font-size:15px;font-weight:300;line-height:1.75;color:#B7BDC8;max-width:40ch">Transporte de carga o asesoría empresarial: un solo canal. Si es un despacho, cuéntenos origen, destino, tipo de carga y fecha estimada.</p>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-fill-gold" style="border:1px solid #BD9750;color:#BD9750;font-size:11px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;padding:17px 30px;min-height:44px;display:inline-flex;align-items:center">Abrir chat de WhatsApp</a>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px">
          <div style="background:#FFFDF8;border:1px solid rgba(12,32,62,0.12);padding:20px 22px">
            <p style="margin:0;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#8A7238">Llamar</p>
            <a href={`tel:+${whatsappNumber}`} style="display:block;margin:8px 0 0;font-size:15px;font-weight:400;color:#0C203E">{whatsappDisplay}</a>
          </div>
          <div style="background:#FFFDF8;border:1px solid rgba(12,32,62,0.12);padding:20px 22px">
            <p style="margin:0;font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#8A7238">Correo</p>
            <a href="mailto:contacto@agorastrategy.co" style="display:block;margin:8px 0 0;font-size:15px;font-weight:400;color:#0C203E;word-break:break-word">contacto@agorastrategy.co</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
